{
  "name": "scholarly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "fetch-models": "node scripts/fetch-models.mjs",
    "test:detector": "node --test server/aiDetector/*.test.js",
    "test:xref": "node --experimental-strip-types --no-warnings --test src/lib/crossReferences.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "docx": "^9.9.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "framer-motion": "^14.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "^1.31.1",
    "openai": "^7.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "^0.2.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
