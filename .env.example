# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENALEX_API_KEY=
CORE_API_KEY=
OPENALEX_MAILTO=
PORT=8787

# Optional abuse/cost limits (defaults shown)
# ANALYZE_LIMIT_PER_HOUR=5
# ANALYZE_LIMIT_PER_DAY=100
# ASK_LIMIT_PER_HOUR=40
# ALLOWED_ORIGINS=

# AI-content detection (self-hosted model; see detector/README.md)
# AI_DETECT_MODEL_URL=https://huggingface.co/<user>/scholarly-detector/resolve/main
# AI_DETECT_MODEL_DIR=./models
# AI_DETECT_MAX_CHARS=300000
# AI_DETECT_MAX_WINDOWS=4000
# Optional: compare against Sapling instead of the local model
# AI_DETECT_PROVIDER=sapling
# SAPLING_API_KEY=
